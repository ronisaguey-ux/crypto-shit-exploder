# --- Trader discovery providers (any subset works; the pipeline degrades gracefully) ---
SOLANATRACKER_API_KEY=
VYBE_API_KEY=
BIRDEYE_API_KEY=
BITQUERY_API_KEY=

# --- Solana RPC / streaming (required for live tracking) ---
HELIUS_API_KEY=
# The webhook refuses to start with this sentinel value — set a real secret.
HELIUS_WEBHOOK_SECRET=change-me

# --- Storage ---
CSE_DB_PATH=data/cse.db
CSE_CONFIG_PATH=config/config.yaml

# --- Webhook server ---
CSE_WEBHOOK_HOST=0.0.0.0
CSE_WEBHOOK_PORT=8000
